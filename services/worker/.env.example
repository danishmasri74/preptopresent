# Copy to .env and fill in. Never commit .env.

ENVIRONMENT=development
# Supabase dashboard > Connect > Session pooler connection string
DATABASE_URL=
POLL_INTERVAL_S=2

# Same values as apps/web/.env.local (project URL + secret key), for Storage access
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Provider keys: added in later phases
ANTHROPIC_API_KEY=
# live = call Claude; mock = test answers with no key and no cost (UI work, demos without a key)
AI_MODE=live
# ElevenLabs: Scribe v3 transcription + Eleven v4 voices
ELEVENLABS_API_KEY=

# Cloudflare R2 (rehearsal videos), same values as apps/web/.env.local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rehearsal-videos
