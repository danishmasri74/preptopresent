# TEMPLATE ONLY: do not put real values in this file (it is committed to git).
# Copy to .env.local and fill in there. .env.local is git-ignored.
# Values come from Supabase dashboard > Project Settings > API Keys.

# Public (safe in the browser; access is enforced by row-level security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# Cloudflare R2 (rehearsal videos), server-only: used to sign upload and playback URLs.
# Cloudflare dashboard > R2 > Manage API tokens (Object Read & Write, this bucket only).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rehearsal-videos
